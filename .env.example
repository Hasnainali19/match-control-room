# --- Azure OpenAI / Azure AI Foundry (optional: without these the app runs on offline templates)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=
# or keyless with managed identity (pip install -r requirements-azure.txt)
AZURE_OPENAI_USE_MANAGED_IDENTITY=0
# --- Observability (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=
# --- App
MCR_DEFAULT_SEED=11
MCR_SUBGROUP_SECONDS=90
MCR_AIRTIME_GAP=40
MCR_LLM_TIMEOUT=8
MCR_LOG_LEVEL=INFO
MCR_LOG_FORMAT=json
MCR_DATA_DIR=./data
# --- GitHub Models (used only when the Azure variables above are not set)
# Precedence: Azure OpenAI > GitHub Models > offline templates
GITHUB_MODELS_TOKEN=            # fine-grained PAT with models:read (GITHUB_TOKEN also accepted)
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini
GITHUB_MODELS_RPM=10            # client-side request budget for the free tier
MCR_LLM_CACHE_SIZE=256
